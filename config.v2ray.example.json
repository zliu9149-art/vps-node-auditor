{
  "database": {
    "path": "/var/lib/vps-node-auditor/audit.db"
  },
  "collector": {
    "source": "sing-box-v2ray",
    "interval": "60s",
    "config_lock_path": "/run/vps-node-auditor/config.lock",
    "v2ray_api": {
      "address": "127.0.0.1:10085",
      "timeout": "5s",
      "process_name": "sing-box"
    }
  },
  "host": {
    "disabled": false,
    "interface": "eth0",
    "command_timeout": "5s"
  },
  "display": {
    "timezone": "Asia/Hong_Kong"
  },
  "provider": {
    "monthly_quota_bytes": 1000000000000,
    "cycle_start_day": 9,
    "billing_timezone": "Asia/Hong_Kong",
    "traffic_direction": "both"
  },
  "retention": {
    "minute_days": 90,
    "event_days": 14,
    "rollup_days": 400,
    "backup_count": 14
  },
  "alerts": {
    "quota_percentages": [50, 75, 90, 95],
    "traffic_difference_percent": 10,
    "consecutive_failures": 3,
    "user_hourly_bytes": 0,
    "user_daily_bytes": 0,
    "historical_spike_factor": 0
  },
  "credentials": [
    {
      "user_name": "alice",
      "credential_name": "alice-main",
      "uuid": "11111111-1111-4111-8111-111111111111",
      "stats_user": "alice-stats",
      "enabled": true
    }
  ]
}
